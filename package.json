{
  "name": "chibicc-dumper",
  "version": "0.0.0",
  "description": "A JSON dumper library derived from chibicc that can output C language tokens and ASTs",
  "author": "Kouji Matsui (@kekyo@mi.kekyo.net)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "chibicc-dumper": "./dist/main.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "include"
  ],
  "scripts": {
    "build": "vite build",
    "test": "npm run build && vitest run",
    "pack": "npm run build && screw-up pack --no-wds --pack-destination ./artifacts/"
  },
  "devDependencies": {
    "@types/node": ">=20.0.0",
    "debug": ">=4.4.0",
    "emsdk-env": ">=0.10.0",
    "prettier-max": ">=1.14.0",
    "screw-up": ">=1.26.0",
    "typescript": ">=5.0.0",
    "vite": ">=5.0.0",
    "vite-plugin-dts": ">=4.5.0",
    "vitest": ">=1.0.0"
  }
}
